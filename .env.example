# Skopiuj do .env i uzupełnij. Klucz publiczny Supabase (anon) jest jawny z założenia: dostęp pilnuje RLS.
VITE_SUPABASE_URL=https://sedno-api.dakowicz.xyz
VITE_SUPABASE_ANON_KEY=

# Opcjonalnie: przycisk „Wejdź na konto demo” na ekranie logowania.
# VITE_DEMO_EMAIL=
# VITE_DEMO_PASSWORD=

# Konto testowe do wspólnego testowania (nie trafia do aplikacji, tylko dla ludzi).
SEDNO_TEST_EMAIL=
SEDNO_TEST_PASSWORD=
