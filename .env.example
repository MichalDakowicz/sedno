# Adres instancji Supabase i klucz publiczny (anon). Wystarczą do działania aplikacji.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Konto testowe do wspólnego testowania (nie trafia do aplikacji, tylko dla ludzi).
SEDNO_TEST_EMAIL=
SEDNO_TEST_PASSWORD=

# Klucze i domyślna trasa AI (dla kont bez własnego klucza)
SEDNO_AI_BASE_URL=https://api.anthropic.com/v1
SEDNO_AI_MODEL_WAZNE=claude-sonnet-5-5
SEDNO_AI_MODEL_LEKKIE=claude-haiku-5-5
# Tablica matematyczna i wypracowania z polskiego; przy Anthropic bez tej zmiennej claude-opus-5-5.
SEDNO_AI_MODEL_MOCNE=claude-opus-5-5
SEDNO_AI_EFFORT_WAZNE=medium
SEDNO_AI_EFFORT_LEKKIE=medium
SEDNO_AI_KEY=sk-ant-...
# Wyszukiwanie w sieci w czacie Pestki (natywne API Anthropic, modele Sonnet/Opus, nie Haiku). Domyślnie włączone; 0 wyłącza.
SEDNO_AI_WEB_SEARCH=1
